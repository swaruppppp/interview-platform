{
  "name": "code-interview-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "sandboxes:build": "docker build -t sandbox-cpp ./sandboxes/cpp && docker build -t sandbox-py ./sandboxes/py && docker build -t sandbox-js ./sandboxes/js",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:client": "npm run dev --workspace=apps/client",
    "workers:scale": "docker compose --profile scale up -d --build --scale worker=4",
    "workers:down": "docker compose --profile scale stop worker && docker compose --profile scale rm -f worker",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:stress:quick": "node scripts/stress-test.mjs --count=100",
    "test:stress": "node scripts/stress-test.mjs --count=1000"
  }
}
