# Server & Databases
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/interview_platform
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=4

# MinIO / S3 Session Replay Storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_BUCKET=interview-replays

# AI Interviewer Co-Pilot (Any OpenAI-compatible API: Gemini, OpenAI, Groq, Ollama)
# Leave LLM_API_KEY empty to test immediately using built-in deterministic fallback mode.
# Example for Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
